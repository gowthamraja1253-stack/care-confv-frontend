# Frontend Environment Variables Template (Provider-Agnostic)
# Copy this file to .env.local for local overrides, or configure via hosting environment variables.

# API Base URL (leave empty in development or when using same-origin / reverse proxy)
# In production with separate API domain, specify HTTPS URL:
# Example: https://api.yourdomain.com
VITE_API_URL=

# Socket.IO Server URL (leave empty to automatically derive from current origin or VITE_API_URL)
# Supports WSS / HTTPS:
# Example: https://api.yourdomain.com
VITE_SOCKET_URL=

# Map Tile URL (Must use HTTPS to avoid mixed-content blocking in browsers)
# Provider-agnostic: Supports OpenStreetMap, Mapbox, CartoDB, Stamen, or self-hosted tile servers
# Example: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# External AI Translation API Endpoint (HTTPS only)
# Leave empty to use default secure backend translation proxy
VITE_TRANSLATION_API_URL=

# WebRTC Public STUN Configuration (Used for direct Peer-to-Peer NAT discovery)
# Comma-separated list of STUN servers (must use stun: protocol)
VITE_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# SECURITY NOTE:
# Never put permanent TURN admin credentials (usernames/passwords) in the frontend.
# TURN relay configuration and short-lived ephemeral credentials (RFC 5766) are securely
# supplied by the backend through GET /api/webrtc/ice-servers.
#
# ARCHITECTURAL NOTE:
# - STUN/TURN handles network connectivity / path selection (P2P vs relay).
#   TURN relays packets byte-for-byte; it DOES NOT solve low bandwidth.
# - ClinicalQoSController handles media adaptation (dynamic bitrate reduction,
#   frame rate scaling, and clinical audio prioritization under degraded networks).
